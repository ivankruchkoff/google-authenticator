#: google-authenticator.php:217 google-authenticator.php:220 google-authenticator.php:223
msgid "Google Authenticator"
msgstr "Google Authenticator"

#: google-authenticator.php:327
msgid "OTP code doesn't match supplied secret, please check you've configured Authenticator correctly."
msgstr "Kod jednorazowy nie pasuje do podanego tajnego klucza. Sprawdź, czy aplikacja uwierzytelniająca została poprawnie skonfigurowana."

#: google-authenticator.php:336
msgid "Congratulations, you have successfully enabled Google Authenticator for your account"
msgstr "Gratulacje, Google Authenticator został włączony dla Twojego konta"

#: google-authenticator.php:351
msgid "iOS: Google Authenticator"
msgstr "iOS: Google Authenticator"

#: google-authenticator.php:355
msgid "Android: Google Authenticator"
msgstr "Android: Google Authenticator"

#: google-authenticator.php:359
msgid "iOS: Microsoft Authenticator"
msgstr "iOS: Microsoft Authenticator"

#: google-authenticator.php:363
msgid "Android: Microsoft Authenticator"
msgstr "Android: Microsoft Authenticator"

#: google-authenticator.php:367
msgid "iOS: Authy"
msgstr "iOS: Authy"

#: google-authenticator.php:371
msgid "Android: Authy"
msgstr "Android: Authy"

#: google-authenticator.php:378 google-authenticator.php:477 google-authenticator.php:974 google-authenticator.php:1207
msgid "Google Authenticator Settings"
msgstr "Ustawienia aplikacji Google Authenticator"

#: google-authenticator.php:382
msgid "If you haven't already done so, please install an authenticator app on your mobile device, for example:"
msgstr "Jeśli jeszcze tego nie zrobiłeś, zainstaluj na swoim urządzeniu mobilnym aplikację uwierzytelniającą, na przykład:"

#: google-authenticator.php:388
msgid "The easiest way to enable your account is to add an account by scanning the QR code using the app."
msgstr "Najprostszym sposobem włączenia uwierzytelniania dwuskładnikowego jest dodanie konta przez skanowanie kodu QR za pomocą aplikacji."

#: google-authenticator.php:390
msgid "An account can also be added by typing in the secret. After you've added your account to the App, please type the code you see on the screen into the Authenticator Code field and press the Verify Authenticator Code button."
msgstr "Konto możesz też dodać, wpisując tajny klucz. Po dodaniu konta w aplikacji wpisz kod widoczny na ekranie w polu „Kod weryfikacyjny” i kliknij przycisk „Weryfikuj wprowadzony kod”."

#: google-authenticator.php:393
msgid "If the account setup was successful, you will be logged out, and will need to login again using your Username, Password and Authenticator code generated using the App on your mobile device."
msgstr "Jeśli weryfikacja konta zakończy się sukcesem, zostaniesz wylogowany i będziesz musiał ponownie zalogować się z użyciem loginu, hasła i wygenerowanego w aplikacji telefonu kodu weryfikacyjnego."

#: google-authenticator.php:480
msgid "Successfully saved your settings for the network"
msgstr "Ustawienia sieci zostały zapisane"

#: google-authenticator.php:482
msgid "Successfully saved your settings for the site"
msgstr "Ustawienia witryny zostały zapisane"

#: google-authenticator.php:487
msgid "Network Settings"
msgstr "Ustawienia sieci"

#: google-authenticator.php:491
msgid "Only use network-wide settings, ignoring site settings."
msgstr "Korzystaj wyłącznie z globalnych ustawień sieci, ignorując ustawienia strony."

#: google-authenticator.php:497
msgid "Two Screen Signin"
msgstr "Korzystaj z dodatkowego ekranu logowania"

#: google-authenticator.php:501
msgid "Ask for authenticator code on secondary login screen"
msgstr "Pytaj o kod weryfikacyjny na drugim ekranie logowania (po podaniu loginu i hasła)"

#: google-authenticator.php:505
msgid "Roles requiring Google Authenticator Enabled"
msgstr "Role użytkowników dla których Google Authenticator ma być aktywny"

#: google-authenticator.php:513
msgid "Network-wide settings in effect, only a super admin can modify them."
msgstr "Obowiązują globalne ustawienia sieci; tylko superadministrator może je zmienić."

#: google-authenticator.php:515
msgid "Change network wide Google Authenticator settings"
msgstr "Zmień ustawienia globalne dla Google Authenticator"

#: google-authenticator.php:555
msgid "Sorry, you can't disable checks for this role as it's enabled at the network level."
msgstr "Przepraszamy, nie możesz wyłączyć weryfikacji dla tej roli, ponieważ jest ona włączona na poziomie sieci."

#. translators: %s: URL of the network settings page
#: google-authenticator.php:558
#, php-format
msgid "Sorry, this role is enabled at the network level and can only be disabled via the <a href=\"%s\">network settings</a>"
msgstr "Przepraszamy, ta rola jest włączona na poziomie globalnym i może zostać wyłączona jedynie przez <a href=\"%s\">ustawienia sieci</a>"

#: google-authenticator.php:588
msgid "If you don't have Google Authenticator enabled for your WordPress account, leave this field empty."
msgstr "Jeżeli nie masz włączonego Google Authenticator dla tego konta WordPress, pozostaw to pole puste."

#: google-authenticator.php:597 google-authenticator.php:601
msgid "Google Authenticator code"
msgstr "Kod weryfikacyjny z Google Authenticator"

#: google-authenticator.php:701
msgid "<strong>ERROR</strong>: Please enter your Google Authenticator code."
msgstr "<strong>BŁĄD</strong>: Wprowadź kod Google Authenticator."

#: google-authenticator.php:703 google-authenticator.php:900
msgid "<strong>ERROR</strong>: The username, password or Google Authenticator code is incorrect, or the code has expired."
msgstr "<strong>BŁĄD</strong>: Nazwa użytkownika, hasło lub kod Google Authenticator są niepoprawne albo kod wygasł."

#: google-authenticator.php:715
msgid "<strong>ERROR</strong>: The Google Authenticator password is incorrect."
msgstr "<strong>BŁĄD</strong>: Hasło Google Authenticator jest niepoprawne."

#. translators: %d: number of minutes
#: google-authenticator.php:831
#, php-format
msgid "<strong>ERROR</strong>: Too many incorrect Google Authenticator codes. Please try again in %d minute."
msgid_plural "<strong>ERROR</strong>: Too many incorrect Google Authenticator codes. Please try again in %d minutes."
msgstr[0] "<strong>BŁĄD</strong>: Zbyt wiele niepoprawnych kodów Google Authenticator. Spróbuj ponownie za %d minutę."
msgstr[1] "<strong>BŁĄD</strong>: Zbyt wiele niepoprawnych kodów Google Authenticator. Spróbuj ponownie za %d minuty."
msgstr[2] "<strong>BŁĄD</strong>: Zbyt wiele niepoprawnych kodów Google Authenticator. Spróbuj ponownie za %d minut."

#: google-authenticator.php:895
msgid "Secondary Login Screen"
msgstr "Dodatkowy ekran logowania"

#: google-authenticator.php:898
msgid "<strong>ERROR</strong>: The Google Authenticator code is missing."
msgstr "<strong>BŁĄD</strong>: Nie wpisano kodu Google Authenticator."

#: google-authenticator.php:911
msgid "Please enter the Google Authenticator code using the app on your device."
msgstr "Wprowadź kod Google Authenticator z aplikacji na swoim urządzeniu."

#: google-authenticator.php:913
msgid "Log In"
msgstr "Zaloguj się"

#: google-authenticator.php:981 google-authenticator.php:1219
msgid "Active"
msgstr "Włączony"

#: google-authenticator.php:990
msgid "Relaxed mode"
msgstr "Tryb większej tolerancji"

#: google-authenticator.php:992
msgid " Relaxed mode allows for more time drifting on your phone clock (&#177;4 min)."
msgstr " Ten tryb pozwala na większe przesunięcia czasowe w zegarze Twojego telefonu (&#177;4 min)."

#: google-authenticator.php:999
msgid "Description"
msgstr "Opis"

#: google-authenticator.php:1000
msgid " Description that you'll see in the Google Authenticator app on your phone."
msgstr " Opis, który będziesz widział w aplikacji Google Authenticator na swoim telefonie."

#: google-authenticator.php:1004
msgid "Secret"
msgstr "Tajny klucz"

#: google-authenticator.php:1008
msgid "Create new secret"
msgstr "Utwórz nowy tajny klucz"

#: google-authenticator.php:1009
msgid "Show/Hide QR code"
msgstr "Pokaż/Ukryj kod QR"

#: google-authenticator.php:1021
msgid "Scan this with the Google Authenticator app."
msgstr "Zeskanuj kod używając aplikacji Google Authenticator."

#: google-authenticator.php:1033
msgid "Enable App password"
msgstr "Włącz hasło aplikacyjne"

#: google-authenticator.php:1035
msgid " Enabling an App password will decrease your overall login security."
msgstr " Włączenie hasła aplikacyjnego obniży ogólny poziom bezpieczeństwa logowania do strony."

#: google-authenticator.php:1043
msgid "Create new password"
msgstr "Utwórz nowe hasło"

#: google-authenticator.php:1044
msgid " Password is not stored in cleartext, this is your only chance to see it."
msgstr " Hasło nie jest przechowywane w postaci jawnej – to Twoja jedyna szansa, aby je zobaczyć."

#: google-authenticator.php:1052
msgid "Authenticator Code"
msgstr "Kod weryfikacyjny"

#: google-authenticator.php:1053
msgid "After adding the site to your authenticator app, type the code it shows here."
msgstr "Po dodaniu witryny do aplikacji uwierzytelniającej wpisz tutaj wyświetlony w niej kod."

#: google-authenticator.php:1059
msgid "Verify Authenticator Code"
msgstr "Weryfikuj wprowadzony kod"

#: google-authenticator.php:1212
msgid "Hide settings from user"
msgstr "Ukryj ustawienia przed użytkownikiem"
